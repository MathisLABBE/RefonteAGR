{
  "manifest_version": 3,
  "name": "AGR Tennis de Table – Affichage confort",
  "short_name": "AGR Confort",
  "version": "5.1.0",
  "description": "Nouvel affichage moderne, lisible et adapté au mobile pour le site de l'AGR Tennis de Table du Haut-Rhin.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Réglages d'affichage",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://agr-tt.fr/agrtt68/*",
        "*://www.agr-tt.fr/agrtt68/*"
      ],
      "css": ["styles/theme.css", "styles/site.css"],
      "js": ["scripts/sitemap.js", "scripts/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
